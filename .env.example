# ====================================================================
# WanderWise Environment Configuration Example
# Copy this file to `backend/.env` and `frontend/.env` with your values.
# ====================================================================

# --------------------------------------------------------------------
# BACKEND SETTINGS (backend/.env)
# --------------------------------------------------------------------
# AI Engine Configuration (Provide at least one, or leave blank to use the curated rules engine)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase Credentials (Optional: if blank, WanderWise runs in in-memory preview mode)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Unsplash Destination Image API (Optional: provides real-time destination photography)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# App & CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
ENVIRONMENT=development

# --------------------------------------------------------------------
# FRONTEND SETTINGS (frontend/.env)
# Note: Vite requires VITE_ prefix. NEVER expose service-role keys here!
# --------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
